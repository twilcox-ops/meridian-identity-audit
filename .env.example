# Microsoft 365 Developer tenant — Entra ID app registration details.
# Copy this file to .env and fill in real values. Never commit .env.
#
# This project uses certificate-based app-only auth, not a client secret:
# secrets expire and leak, certificates are what production actually uses.

# Entra ID tenant ID (directory ID) the app is registered in.
GRAPH_TENANT_ID=

# Application (client) ID of the registered app.
GRAPH_CLIENT_ID=

# Path to the private key file (PEM) used to sign the auth assertion.
# Keep this outside the repo; point at a vault or the OS certificate store
# in anything beyond local dev.
GRAPH_CERT_PATH=

# SHA-1 thumbprint of the certificate uploaded to the app registration,
# used to tell Graph which public key to verify the assertion against.
GRAPH_CERT_THUMBPRINT=

# Address the severity-ranked audit report is emailed to.
DIGEST_TO=

# Address the audit report is sent from.
DIGEST_FROM=
